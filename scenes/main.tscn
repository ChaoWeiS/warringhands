[node name="Buildings" type="Node3D" parent="World"]
script = ExtResource("7_buildings")
sim_path = NodePath("../../Sim")

[node name="Units" type="Node3D" parent="World"]
script = ExtResource("4_units")
sim_path = NodePath("../../Sim")

[node name="Panes" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_panes")
world_path = NodePath("../World")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Hint" type="Label" parent="HUD"]
offset_left = 24.0
offset_top = 16.0
offset_right = 1100.0
offset_bottom = 100.0
theme_override_colors/font_color = Color(0.35, 0.33, 0.44, 1)
theme_override_font_sizes/font_size = 20
text = "Tap a unit or draw a loop to select  ·  Tap ground to move, an enemy to attack, a resource to gather
Attack button + tap: charge  ·  Build + pick + tap: place a factory  ·  Tap your factory to train
Double tap a unit: all of its type  ·  Units + tap HQ: gather  ·  Double tap a damaged building: repair
Side tab swipe: cut  ·  Divider: resize / merge  ·  Two fingers: pan / zoom"

[node name="SelectionBar" type="HBoxContainer" parent="HUD"]
script = ExtResource("5_bar")

[node name="Economy" type="Control" parent="HUD"]
mouse_filter = 2
script = ExtResource("8_hud")

[node name="Game" type="Node" parent="."]
script = ExtResource("6_game")
panes_path = NodePath("../Panes")
sim_path = NodePath("../Sim")
view_path = NodePath("../World/Units")
bar_path = NodePath("../HUD/SelectionBar")
buildings_path = NodePath("../World/Buildings")
